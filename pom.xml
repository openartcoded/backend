  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <poi.version>5.5.1</poi.version>
    <java.version>25</java.version>
    <!-- Spring Boot 4 (Spring Framework 7, Jackson 3, Spring Security 7, Spring Data 2025.1, Testcontainers 2) -->
    <spring.boot.starter.version>4.1.2</spring.boot.starter.version>
    <json-path.version>2.9.0</json-path.version>
    <commons-lang3.version>3.21.0</commons-lang3.version>
    <commons-text.version>1.15.0</commons-text.version>
    <commons-io.version>2.22.0</commons-io.version>
    <jena-core.version>6.2.0</jena-core.version>
    <!-- 4.23.x is the LTS line built on Spring Boot 4.1 (4.18 was the last one on Spring Boot 3) -->
    <camel.version>4.23.0</camel.version>
    <commonmark.version>0.29.0</commonmark.version>
    <zt-exec.version>1.12</zt-exec.version>
    <!-- 3.2.x is the springdoc line for Spring Boot 4.1 -->
    <springdoc.version>3.2.0</springdoc.version>
    <zip4j.version>2.11.5</zip4j.version>
    <!-- database migrations: Flamingock is the successor of Mongock (no Spring Boot 4 support), it supports Spring Boot 2 to 4.
         The legacy Mongock @ChangeUnit classes keep running unchanged and their audit history is imported -->
    <flamingock.version>1.4.5</flamingock.version>
    <greenmail.version>2.1.9</greenmail.version>
    <commons-compress.version>1.28.0</commons-compress.version>
    <pdfbox.version>3.0.8</pdfbox.version>
    <!-- html -> pdf with headless chromium (replaces the wkhtmltopdf executable) -->
    <playwright.version>1.64.0</playwright.version>
        <graalvm.version>25.0.4</graalvm.version>
    <angus.mail.version>2.0.5</angus.mail.version>
    <phive.version>12.2.0</phive.version>
    <!-- 4.6.x ships the OpenPeppol May 2026 billing rules (BIS 3.0.21, mandatory since 2026-08-17) -->
    <phive-rules-peppol.version>4.6.4</phive-rules-peppol.version>
    <ph-ubl.version>10.2.1</ph-ubl.version>
    <qrcodegen.version>1.8.0</qrcodegen.version>
    <lombok.version>1.18.48</lombok.version>
    <file-service-java-client.version>0.15</file-service-java-client.version>
  </properties>

  <scm>
    <connection>
      scm:git:git@github.com:openartcoded/backend.git
    </connection>
    <tag>2027.6.0</tag>
  </scm>

