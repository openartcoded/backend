{#- converted from template-peppol-2025.xml (FreeMarker) -#}
{%- set UBL_UNITS = {"DAYS": "DAY", "HOURS": "HUR"} -%}
{#- 1234.50: amounts with two decimals -#}
{%- macro amount(x) -%}{{ x|number(decimals=2, thousands="", decimal=".") }}{%- endmacro -%}
{#- 21 / 1.5: plain number (FreeMarker ?c) -#}
{%- macro plain(x) -%}{% if x == x|int %}{{ x|int }}{% else %}{{ x }}{% endif %}{%- endmacro -%}
<?xml version="1.0" encoding="UTF-8"?>
<Invoice xmlns="urn:oasis:names:specification:ubl:schema:xsd:Invoice-2"
   xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
   xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2">
   <cbc:UBLVersionID>2.1</cbc:UBLVersionID>
   <cbc:CustomizationID>urn:cen.eu:en16931:2017#compliant#urn:fdc:peppol.eu:2017:poacc:billing:3.0</cbc:CustomizationID>
   <cbc:ProfileID>urn:fdc:peppol.eu:2017:poacc:billing:01:1.0</cbc:ProfileID>
   <cbc:ID>{{ invoice.newInvoiceNumber }}</cbc:ID>
   <cbc:IssueDate>{{ invoice.dateOfInvoice|dateformat(format="%Y-%m-%d", tz="Europe/Brussels") }}</cbc:IssueDate>
   <cbc:DueDate>{{ invoice.dueDate|dateformat(format="%Y-%m-%d", tz="Europe/Brussels") }}</cbc:DueDate>
   <cbc:InvoiceTypeCode>380</cbc:InvoiceTypeCode><!-- code 380 indicates a Commercial Invoice -->
  <cbc:Note>Payment is due within {{ invoice.maxDaysToPay }} days. Please be aware that we will charge
      {{ personalInfo.financeCharge }}% interest per month on late invoices.
      {{ (personalInfo.note or "")|e }}
      {% if invoice.specialNote %}
         {{ (invoice.specialNote or "")|e }}
      {% endif %}
   </cbc:Note>
   <cbc:DocumentCurrencyCode>EUR</cbc:DocumentCurrencyCode>
   <cbc:BuyerReference>{{ (billableClient.projectName or "")|e }}</cbc:BuyerReference>
    <cac:OrderReference>
      <cbc:ID>{{ (invoice.reference or "")|e }}</cbc:ID>
    </cac:OrderReference>
    <cac:AdditionalDocumentReference>
    <cbc:ID>{{ (pdfName or "")|e }}</cbc:ID>
    <cbc:DocumentType>CommercialInvoice</cbc:DocumentType>
    <cac:Attachment>
      <cbc:EmbeddedDocumentBinaryObject mimeCode="application/pdf" filename="{{ (pdfName or "")|e }}">{{ pdfBytes }}</cbc:EmbeddedDocumentBinaryObject>
    </cac:Attachment>
  </cac:AdditionalDocumentReference>
   <cac:AccountingSupplierParty>
      <cac:Party>
         <cbc:EndpointID schemeID="0195">{{ personalInfo.cleanVatNumber }}</cbc:EndpointID>
         <cac:PartyIdentification>
            <cbc:ID schemeID="0208">{{ personalInfo.companyNumber }}</cbc:ID>
         </cac:PartyIdentification>
         <cac:PartyName>
            <cbc:Name>{{ (personalInfo.organizationName or "")|e }}</cbc:Name>
         </cac:PartyName>
         <cac:PostalAddress>
            <cbc:StreetName>{{ (personalInfo.organizationAddress or "")|e }}</cbc:StreetName>
            <cbc:CityName>{{ (personalInfo.organizationCity or "")|e }}</cbc:CityName>
            <cbc:PostalZone>{{ (personalInfo.organizationPostCode or "")|e }}</cbc:PostalZone>
             <cac:Country>
               <cbc:IdentificationCode>{{ personalInfo.countryCode }}</cbc:IdentificationCode>
            </cac:Country>
          </cac:PostalAddress>
         <cac:PartyTaxScheme>
            <cbc:CompanyID>{{ personalInfo.cleanVatNumber }}</cbc:CompanyID>
            <cac:TaxScheme>
               <cbc:ID>VAT</cbc:ID>
            </cac:TaxScheme>
         </cac:PartyTaxScheme>
         <cac:PartyLegalEntity>
            <cbc:RegistrationName>{{ (personalInfo.organizationName or "")|e }}</cbc:RegistrationName>
            <cbc:CompanyID schemeID="0208">{{ personalInfo.companyNumber }}</cbc:CompanyID>
         </cac:PartyLegalEntity>
         <cac:Contact>
            <cbc:ElectronicMail>{{ (personalInfo.organizationEmailAddress or "")|e }}</cbc:ElectronicMail>
         </cac:Contact>
      </cac:Party>
   </cac:AccountingSupplierParty>
   <cac:AccountingCustomerParty>
      <cac:Party>
         <cbc:EndpointID schemeID="0195">{{ billableClient.cleanVatNumber }}</cbc:EndpointID>
         <cac:PartyIdentification>
            <cbc:ID schemeID="0208">{{ billableClient.companyNumber }}</cbc:ID>
         </cac:PartyIdentification>
         <cac:PartyName>
            <cbc:Name>{{ (billableClient.name or "")|e }}</cbc:Name>
         </cac:PartyName>
         <cac:PostalAddress>
            <cbc:StreetName>{{ (billableClient.address or "")|e }}</cbc:StreetName>
            <cbc:CityName>{{ (billableClient.city or "")|e }}</cbc:CityName>
            <!--<cbc:PostalZone>1000</cbc:PostalZone>-->
            <cac:Country>
               <cbc:IdentificationCode>{{ billableClient.countryCode }}</cbc:IdentificationCode>
            </cac:Country>
         </cac:PostalAddress>
         <cac:PartyTaxScheme>
            <cbc:CompanyID>{{ billableClient.cleanVatNumber }}</cbc:CompanyID>
            <cac:TaxScheme>
               <cbc:ID>VAT</cbc:ID>
            </cac:TaxScheme>
         </cac:PartyTaxScheme>
         <cac:PartyLegalEntity>
            <cbc:RegistrationName>{{ (billableClient.name or "")|e }}</cbc:RegistrationName>
            <cbc:CompanyID schemeID="0208">{{ billableClient.companyNumber }}</cbc:CompanyID>
         </cac:PartyLegalEntity>
         <cac:Contact>
            <cbc:ElectronicMail>{{ (billableClient.emailAddress or "")|e }}</cbc:ElectronicMail>
         </cac:Contact>
      </cac:Party>
   </cac:AccountingCustomerParty>

 <cac:PaymentMeans>
    <cbc:PaymentMeansCode listID="UN/ECE 4461" listName="Payment Means" listURI="http://docs.oasis-open.org/ubl/os-UBL-2.0-update/cl/gc/default/PaymentMeansCode-2.0.gc">1</cbc:PaymentMeansCode>
    <cbc:PaymentDueDate>{{ invoice.dueDate|dateformat(format="%Y-%m-%d", tz="Europe/Brussels") }}</cbc:PaymentDueDate>
    <cac:PayeeFinancialAccount>
      <cbc:ID schemeName="IBAN">{{ personalInfo.organizationBankAccount }}</cbc:ID>
      <cac:FinancialInstitutionBranch>
        <cac:FinancialInstitution>
          <cbc:ID schemeName="BIC">{{ personalInfo.organizationBankBIC }}</cbc:ID>
        </cac:FinancialInstitution>
      </cac:FinancialInstitutionBranch>
    </cac:PayeeFinancialAccount>
  </cac:PaymentMeans>
   <cac:PaymentTerms>
    <cbc:Note>{{ (invoice.structuredReference or "")|e }}</cbc:Note>
   </cac:PaymentTerms>

   <cac:TaxTotal>
      <cbc:TaxAmount currencyID="EUR">{{ amount(invoice.taxes) }}</cbc:TaxAmount>
      <cac:TaxSubtotal>
         <cbc:TaxableAmount currencyID="EUR">{{ amount(invoice.subTotal) }}</cbc:TaxableAmount>
         <cbc:TaxAmount currencyID="EUR">{{ amount(invoice.taxes) }}</cbc:TaxAmount>
         <cac:TaxCategory>
            <cbc:ID>S</cbc:ID> <!--Standard rate-->
            <cbc:Percent>{{ plain(invoice.taxRate) }}</cbc:Percent>
            <cac:TaxScheme>
               <cbc:ID>VAT</cbc:ID>
            </cac:TaxScheme>
         </cac:TaxCategory>
      </cac:TaxSubtotal>
   </cac:TaxTotal>
   <cac:LegalMonetaryTotal>
      <cbc:LineExtensionAmount currencyID="EUR">{{ amount(invoice.subTotal) }}</cbc:LineExtensionAmount>
      <cbc:TaxExclusiveAmount currencyID="EUR">{{ amount(invoice.subTotal) }}</cbc:TaxExclusiveAmount>
      <cbc:TaxInclusiveAmount currencyID="EUR">{{ amount(invoice.total) }}</cbc:TaxInclusiveAmount>
      <cbc:PayableAmount currencyID="EUR">{{ amount(invoice.total) }}</cbc:PayableAmount>
   </cac:LegalMonetaryTotal>
   {% for table in invoice.invoiceTable %}
   <cac:InvoiceLine>
      <cbc:ID>{{ loop.index }}</cbc:ID>
      <cbc:InvoicedQuantity unitCode="{{ UBL_UNITS[table.amountType] }}">{{ plain(table.amount) }}</cbc:InvoicedQuantity>
      <cbc:LineExtensionAmount currencyID="EUR">{{ amount(table.total) }}</cbc:LineExtensionAmount>
      <cac:Item>
         <cbc:Description>{{ (table.period or "")|e }}</cbc:Description>
         <cbc:Name>{{ (table.nature or "")|e }}</cbc:Name>
         <cac:ClassifiedTaxCategory>
            <cbc:ID>S</cbc:ID>
            <cbc:Percent>21</cbc:Percent>
            <cac:TaxScheme>
               <cbc:ID>VAT</cbc:ID>
            </cac:TaxScheme>
         </cac:ClassifiedTaxCategory>
      </cac:Item>
      <cac:Price>
         <cbc:PriceAmount currencyID="EUR">{{ plain(table.rate) }}</cbc:PriceAmount>
         <cbc:BaseQuantity unitCode="{{ UBL_UNITS[table.rateType] }}">1</cbc:BaseQuantity>
      </cac:Price>
   </cac:InvoiceLine>
   {% endfor %}
</Invoice>
