<#-- string literal: quotes, backslashes and line breaks escaped, so a value can't break the query -->
<#function lit value><#return "\"" + (value!"")?string?replace("\\", "\\\\")?replace("\"", "\\\"")?replace("\n", "\\n")?replace("\r", "\\r") + "\""></#function>
<#-- iri: characters not allowed between < > are percent encoded -->
<#function iri value><#return "<" + value?trim?replace(" ", "%20")?replace("<", "%3C")?replace(">", "%3E")?replace("\"", "%22")?replace("{", "%7B")?replace("}", "%7D")?replace("|", "%7C")?replace("\\", "%5C")?replace("^", "%5E")?replace("`", "%60") + ">"></#function>
<#function day value><#return "\"" + value?date?iso_utc + "\"^^xsd:date"></#function>
PREFIX bi: <https://bittich.be/vocabularies/core/>
PREFIX adms: <http://www.w3.org/ns/adms#>
PREFIX regorg: <http://www.w3.org/ns/regorg#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX schema: <http://schema.org/>
PREFIX org: <http://www.w3.org/ns/org#>
PREFIX locn: <http://www.w3.org/ns/locn#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX cv: <http://rdfs.org/resume-rdf/cv.rdfs#>
PREFIX baseCv: <http://rdfs.org/resume-rdf/base.rdfs#>

DELETE {
  GRAPH <${graph}> {
      ?s ?p ?o
  }
}
INSERT  {
  GRAPH <${graph}> {
      <https://bittich.be/concept-schemes/skill-type> a skos:ConceptScheme;
                                                      skos:prefLabel "Skill Type"@en .

      <https://bittich.be/concepts/hard-skill>  a skos:Concept;
                                                skos:inScheme <https://bittich.be/concept-schemes/skill-type>;
                                                skos:topConceptOf <https://bittich.be/concept-schemes/skill-type>;
                                                skos:prefLabel "Hard Skill";
                                                skos:altLabel "Hard Skill".
      <https://bittich.be/concepts/soft-skill>  a skos:Concept;
                                                skos:inScheme <https://bittich.be/concept-schemes/skill-type>;
                                                skos:topConceptOf <https://bittich.be/concept-schemes/skill-type>;
                                                skos:prefLabel "Soft Skill";
                                                skos:altLabel "Soft Skill".


      <https://bittich.be/cv/${cv.id}> a cv:CV;
                <#if cv.introduction?has_content>cv:cvDescription ${lit(cv.introduction)};</#if>
                cv:aboutPerson <https://bittich.be/cv/about/${cv.id}>.

      <#assign person = cv.person!{}>
      <https://bittich.be/cv/about/${cv.id}> a foaf:Person
                <#if person.firstname?has_content>; foaf:firstName ${lit(person.firstname)}</#if>
                <#if person.lastname?has_content>; foaf:lastName ${lit(person.lastname)}</#if>
                <#if person.title?has_content>; foaf:title ${lit(person.title)}</#if>
                <#if person.birthdate??>; foaf:birthday ${day(person.birthdate)}</#if>
                <#if person.linkedinUrl?has_content>; foaf:account ${iri(person.linkedinUrl)}</#if>
                <#if person.githubUrl?has_content>; foaf:account ${iri(person.githubUrl)}</#if>
                <#if person.website?has_content>; foaf:homepage ${iri(person.website)}</#if>.

      <#list cv.skills![] as skill>
        <#assign skillId = _uuid()>
      <https://bittich.be/cv/skill/${skillId}> a cv:Skill
                <#if skill.name?has_content>; cv:skillName ${lit(skill.name)}</#if>
                <#if skill.softSkill>; <https://bittich.be/concept-schemes/skill-type> <https://bittich.be/concepts/soft-skill></#if>
                <#if skill.hardSkill>; <https://bittich.be/concept-schemes/skill-type> <https://bittich.be/concepts/hard-skill></#if>
                <#if skill.tags?has_content>; bi:tags ${skill.tags?map(t -> lit(t))?join(", ")}</#if>.
      <https://bittich.be/cv/${cv.id}> cv:hasSkill <https://bittich.be/cv/skill/${skillId}>.
      </#list>

      <#list cv.hobbies![] as hobby>
        <#assign hobbyId = _uuid()>
      <https://bittich.be/cv/hobby/${hobbyId}> a cv:OtherInfo;
                cv:otherInfoType "interests"
                <#if hobby.title?has_content>; foaf:title ${lit(hobby.title)}</#if>
                <#if hobby.description?has_content>; cv:otherInfoDescription ${lit(hobby.description)}</#if>.
      <https://bittich.be/cv/${cv.id}> cv:hasOtherInfo <https://bittich.be/cv/hobby/${hobbyId}>.
      </#list>

      <#list cv.personalProjects![] as pp>
        <#assign ppId = _uuid()>
      <https://bittich.be/cv/personal-project/${ppId}> a cv:OtherInfo;
                cv:otherInfoType "accomplishments"
                <#if pp.name?has_content>; foaf:title ${lit(pp.name)}</#if>
                <#if pp.url?has_content>; foaf:homepage ${iri(pp.url)}</#if>
                <#if pp.description?has_content>; cv:otherInfoDescription ${lit(pp.description)}</#if>.
      <https://bittich.be/cv/${cv.id}> cv:hasOtherInfo <https://bittich.be/cv/personal-project/${ppId}>.
      </#list>

      <#list cv.scholarHistories![] as sch>
        <#assign schId = _uuid()>
      <https://bittich.be/cv/school/${schId}> a cv:EducationalOrg
                <#if sch.school?has_content>; foaf:name ${lit(sch.school)}</#if>.
      <https://bittich.be/cv/education/${schId}> a cv:Education;
                cv:studiedIn <https://bittich.be/cv/school/${schId}>
                <#if sch.from??>; cv:eduStartDate ${day(sch.from)}</#if>
                <#if sch.to??>; cv:eduGradDate ${day(sch.to)}</#if>
                <#if sch.title?has_content>; cv:eduDescription ${lit(sch.title)}</#if>.
      <https://bittich.be/cv/${cv.id}> cv:hasEducation <https://bittich.be/cv/education/${schId}>.
      </#list>

      <#list cv.experiences![] as exp>
        <#assign expId = _uuid()>
      <https://bittich.be/cv/company/${expId}> a cv:Company
                <#if exp.company?has_content>; foaf:name ${lit(exp.company)}</#if>.
      <https://bittich.be/cv/experience/${expId}> a cv:WorkHistory;
                cv:employedIn <https://bittich.be/cv/company/${expId}>;
                cv:isCurrent "${exp.current?string('true', 'false')}"^^xsd:boolean
                <#if exp.from??>; cv:startDate ${day(exp.from)}</#if>
                <#if exp.to??>; cv:endDate ${day(exp.to)}</#if>
                <#if exp.description?has_content>; cv:jobDescription ${lit(exp.description?join("\n"))}</#if>
                <#if exp.title?has_content>; cv:jobTitle ${lit(exp.title)}</#if>.
      <https://bittich.be/cv/${cv.id}> cv:hasWorkHistory <https://bittich.be/cv/experience/${expId}>.
      </#list>

  }
}
WHERE  {
  GRAPH <${graph}> {
   optional {
    ?s ?a  ?type; ?p ?o.
      VALUES ?type {
            skos:ConceptScheme
            cv:CV
            foaf:Person
            cv:Skill
            cv:OtherInfo
            cv:EducationalOrg
            cv:Education
            cv:Company
            cv:WorkHistory
        }
   }
  }

}

